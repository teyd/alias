# Every setting of a deploy (`pnpm infra:deploy`, scripts/deploy.ts). Copy to infra/.env (ignored
# by git) or set them in the environment. One-time account steps: PLAN.md §20.37.

# The stage: names every resource (`alias-<stage>-…`, `/alias/<stage>/…`) and Alchemy's state.
# `local` is the Cloudflare-free stage (no DNS, test Turnstile keys, `*.cloudfront.net` only).
ALIAS_STAGE=prod

# Shared domains, comma-separated. The first one serves the web app and the API (passkeys are
# bound to it). Each must be a Cloudflare zone in CLOUDFLARE_ACCOUNT_ID, or under one.
ALIAS_SHARED_DOMAINS=alias.example

# Temp-mail domains (PLAN.md §20.22), comma-separated, never a shared domain. Empty: no temp mail.
ALIAS_TEMP_DOMAINS=

# Who gets the alarms (SES reputation, capacity) and the budget mails. SNS mails a confirmation
# link first; nothing arrives until it is followed. Optional, but nobody is told anything without.
ALIAS_ALERT_EMAIL=

# Monthly cost budget for the AWS account, in USD (default 20).
ALIAS_BUDGET_USD=20

# Sign-ups everyone together may make in an hour before sign-up pauses (default 100, §20.27).
ALIAS_MAX_SIGNUPS_PER_HOUR=100

# Cloudflare: the account holding the zones, and an API token on it with
#   Account · Turnstile · Edit, Zone · Zone · Read and Zone · DNS · Edit (all zones above).
# Both set: they win. Token empty: Alchemy's profile is used (`pnpm infra:alchemy profile edit`).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# AWS: credentials come from Alchemy's profile (`pnpm infra:alchemy profile edit`, AWS → Console
# login with the profile `pnpm infra:aws login --profile alias --region eu-west-1` made, or SSO),
# or AWS_ACCESS_KEY_ID and friends if set.
# Which Alchemy profile (default `default`):
ALCHEMY_PROFILE=default
# The AWS CLI profile (~/.aws/config) behind it; `alchemy provider aws bootstrap` (Alchemy's bucket
# for Lambda code, made once per account and region) takes it by name.
AWS_PROFILE=alias
