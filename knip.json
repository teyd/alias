{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**"],
  "ignoreBinaries": ["mise"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts!"]
    },
    "apps/api": {
      "entry": ["src/handler.ts!", "bin/*.ts"]
    },
    "tools/aws-emulators": {
      "entry": ["bin/*.ts"]
    },
    "tools/ses-emulator": {
      "entry": ["bin/*.ts"]
    }
  },
  "includeEntryExports": true
}
