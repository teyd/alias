{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [".agents/**"],
  "ignoreBinaries": ["mise"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts!"]
    },
    "apps/api": {
      "entry": ["src/handler.ts!", "bin/*.ts"]
    },
    "apps/inbound": {
      "entry": ["src/handler.ts!", "src/feedbackHandler.ts!", "bin/*.ts"]
    },
    "infra": {
      "entry": ["alchemy.run.ts!"]
    },
    "tools/aws-emulators": {
      "entry": ["bin/*.ts"]
    },
    "apps/webhooks": {
      "entry": ["src/handler.ts!", "bin/*.ts"]
    }
  },
  "includeEntryExports": true
}
